# ==========================================
# Database Configuration (SQLAlchemy)
# ==========================================
# For local dev: sqlite:///./notebooks.db
# For AWS RDS PostgreSQL: postgresql://username:password@rds-endpoint.amazonaws.com:5432/notebooks_db
DATABASE_URL=sqlite:///./notebooks.db

# ==========================================
# Open Source LLM Engines (DeepSeek-R1 / Llama 3.3 / Qwen)
# ==========================================
# Option 1: Groq (Recommended - Free high-throughput API from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=deepseek-r1-distill-llama-70b

# Option 2: Local Ollama (Zero API keys needed, runs fully offline on your PC)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-r1

# Option 3: Hugging Face (Open Source models)
HF_TOKEN=your_huggingface_token_here
HF_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Open Source Vector Embeddings (Runs locally on CPU with MiniLM - 0 API calls needed)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# Source Discovery (Google Search for Articles & YouTube via SerpAPI)
# ==========================================
SERPAPI_API_KEY=your_serpapi_key_for_google_discovery

# ==========================================
# AWS Cloud Services (S3 Document Storage)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-notebook-sources-s3-bucket

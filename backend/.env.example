# ==========================================
# Database Configuration (SQLAlchemy)
# ==========================================
# For local dev: defaults to sqlite:///./notebooks.db
# For AWS RDS PostgreSQL: postgresql://username:password@rds-endpoint.amazonaws.com:5432/notebooks_db
DATABASE_URL=sqlite:///./notebooks.db

# ==========================================
# Meta Llama 3.3 70B Engine (Groq / HuggingFace)
# ==========================================
# Get instant free high-throughput API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile

# Hugging Face fallback
HF_TOKEN=your_huggingface_token_here
HF_LLAMA_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Google Gemini fallback
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# AWS Cloud Services
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-notebook-sources-s3-bucket

# ==========================================
# Source Discovery (YouTube & Web Search)
# ==========================================
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
SERPAPI_API_KEY=your_serpapi_key_for_google_articles
